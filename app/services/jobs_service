from app.core.redis_client import RedisClient
from app.api.api_client import APIClient
from app.api.jobs_api import JobsAPI

class JobsService:

      def __init__(self, redis_client: RedisClient = None, api_client: APIClient = None, jobs_api: JobsAPI = None):
            self.redis_client = RedisClient()
            self.api_client = APIClient()
            self.jobs_api = JobsAPI()

      
      def _upsert_job(self, job: dict):
            """Upsert a job posting into Redis."""
            
            # first check if job already exists using fingerprint jobs:job:fingerprint
            fingerprint = self.jobs_api.fingerprint_job(job)
            
            existing_job = self.redis_client.hgetall(f"jobs:job:{fingerprint}")
            if existing_job:
                  # Job already exists, skip insertion
                  return
            # Insert new job
            self.redis_client.hset(f"jobs:job:{fingerprint}", job)



            